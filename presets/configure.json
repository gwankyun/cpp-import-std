{
    "version": 10,
    "include": [
        "configure-base.json"
    ],
    "configurePresets": [
        {
            "name": "msvc",
            "inherits": [
                "msvc-base"
            ]
        },
        {
            "name": "msvc-ninja",
            "inherits": [
                "ninja"
            ],
            "description": "Ninja + MSVC（命令行需在 Developer PowerShell 中運行；VS 用 Open Folder 自動識別）"
        },
        {
            "name": "clang",
            "inherits": [
                "clang-base"
            ]
        },
        {
            "name": "gcc",
            "inherits": [
                "gcc-base"
            ]
        },
        {
            "name": "clangcl",
            "inherits": [
                "clangcl-base"
            ]
        },
        {
            "name": "clangcl-ninja",
            "inherits": [
                "clangcl-ninja-base"
            ]
        }
    ]
}